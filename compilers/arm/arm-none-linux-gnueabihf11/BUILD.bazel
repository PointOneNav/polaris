package(default_visibility = ["//visibility:public"])

load(":cc_toolchain_config.bzl", "cc_toolchain_config")

filegroup(name = "empty")

filegroup(
    name = 'wrappers',
    srcs = glob([
        'arm-none-*',
    ]),
)

filegroup(
    name = 'all_files',
    srcs = [
        ':wrappers',
        "@arm-none-linux-gnueabihf11//:toolchain",
    ],
)

cc_toolchain_config(
    name = "arm_toolchain_config",
    compiler = "gcc",
    cpu = "arm-none-linux-gnueabihf",
)

cc_toolchain(
    name = "arm_toolchain",
    toolchain_identifier = "arm-toolchain",
    toolchain_config = ":arm_toolchain_config",
    all_files = ":all_files",
    compiler_files = ":all_files",
    dwp_files = ":empty",
    linker_files = ":all_files",
    objcopy_files = ":all_files",
    strip_files = ":all_files",
)

cc_toolchain_suite(
    name = "gcc_toolchain",
    toolchains = {
        "arm": ":arm_toolchain",
    },
    tags = ["manual"]
)
