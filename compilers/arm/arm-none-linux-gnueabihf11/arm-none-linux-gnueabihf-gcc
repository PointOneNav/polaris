#!/bin/bash --norc

if [[ -z "${EXT_BUILD_ROOT}" ]]; then
  MY_PREFIX=""
else
  MY_PREFIX="${EXT_BUILD_ROOT}/"
fi

PATH="${MY_PREFIX}external/arm-none-linux-gnueabihf11/libexec/gcc/arm-none-linux-gnueabihf/11.2.1:$PATH" \
    exec \
    ${MY_PREFIX}external/arm-none-linux-gnueabihf11/bin/arm-none-linux-gnueabihf-gcc \
    "$@"
